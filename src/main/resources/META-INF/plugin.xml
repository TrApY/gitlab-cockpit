<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>dev.jota.gitlabcockpit</id>
    <name>Cockpit for GitLab</name>
    <!-- Vendor por defecto del bootstrap; pendiente de confirmar/cambiar por el usuario antes de la primera subida -->
    <vendor email="j.t.m.s.89@gmail.com" url="https://github.com/TrApY/gitlab-cockpit">JoTa</vendor>
    <!-- The <description> is injected at build time from the README.md "Plugin description" section (see build.gradle.kts). -->

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <resource-bundle>messages.CockpitBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
            parentId="tools"
            instance="dev.jota.gitlabcockpit.settings.ui.GitLabCockpitConfigurable"
            id="dev.jota.gitlabcockpit.settings"
            displayName="Cockpit for GitLab"/>
        <toolWindow
            id="GitLab Cockpit"
            anchor="right"
            factoryClass="dev.jota.gitlabcockpit.ui.CockpitToolWindowFactory"
            icon="AllIcons.Vcs.Vendors.Github"/>
        <notificationGroup
            id="Cockpit for GitLab"
            displayType="BALLOON"/>
        <diff.DiffExtension
            implementation="dev.jota.gitlabcockpit.ui.diff.CockpitDiffExtension"/>
        <postStartupActivity
            implementation="dev.jota.gitlabcockpit.core.BackgroundNotificationsPoller"/>
    </extensions>
</idea-plugin>
