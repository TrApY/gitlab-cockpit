<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>dev.jota.gitlabcockpit</id>
    <name>Cockpit for GitLab</name>
    <!-- Vendor por defecto del bootstrap; pendiente de confirmar/cambiar por el usuario antes de la primera subida -->
    <vendor email="j.t.m.s.89@gmail.com" url="https://github.com/TrApY/gitlab-cockpit">JoTa</vendor>
    <!-- The <description> is injected at build time from the README.md "Plugin description" section (see build.gradle.kts). -->

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <resource-bundle>messages.CockpitBundle</resource-bundle>

    <!-- Keyboard-first diff review (GLC-29). All remappable and added to the diff editor's context
         menu; each borrows a platform gesture via use-shortcut-of (no keystrokes of our own):
         New comment at caret -> Code.Review.Editor.New.Comment (Ctrl+Shift+X); thread navigation ->
         Next/PreviousOccurence (Ctrl+Alt+Down/Up), matching the bundled GitHub review actions.
         Texts/descriptions come from the resource-bundle (action.<id>.text/.description). -->
    <actions>
        <action id="Cockpit.Diff.NewComment"
                class="dev.jota.gitlabcockpit.ui.diff.CockpitNewCommentAction"
                icon="AllIcons.General.Balloon"
                use-shortcut-of="Code.Review.Editor.New.Comment">
            <add-to-group group-id="Diff.EditorPopupMenu" anchor="last"/>
        </action>
        <action id="Cockpit.Diff.PreviousThread"
                class="dev.jota.gitlabcockpit.ui.diff.CockpitPreviousThreadAction"
                icon="AllIcons.Actions.PreviousOccurence"
                use-shortcut-of="PreviousOccurence">
            <add-to-group group-id="Diff.EditorPopupMenu" anchor="last"/>
        </action>
        <action id="Cockpit.Diff.NextThread"
                class="dev.jota.gitlabcockpit.ui.diff.CockpitNextThreadAction"
                icon="AllIcons.Actions.NextOccurence"
                use-shortcut-of="NextOccurence">
            <add-to-group group-id="Diff.EditorPopupMenu" anchor="last"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
            parentId="tools"
            instance="dev.jota.gitlabcockpit.settings.ui.GitLabCockpitConfigurable"
            id="dev.jota.gitlabcockpit.settings"
            displayName="Cockpit for GitLab"/>
        <!-- canCloseContents lets the per-MR tabs be closed (X, middle click, context menu). Without it
             the platform disables every close affordance even for a closeable Content (GLC-38 / iter3 C);
             the list tab stays non-closeable via its own Content.isCloseable=false. -->
        <toolWindow
            id="GitLab Cockpit"
            anchor="bottom"
            canCloseContents="true"
            factoryClass="dev.jota.gitlabcockpit.ui.CockpitToolWindowFactory"
            icon="/icons/toolwindow.svg"/>
        <notificationGroup
            id="Cockpit for GitLab"
            displayType="BALLOON"
            icon="/icons/toolwindow.svg"/>
        <!-- A second group with the same look but STICKY_BALLOON display, used when the opt-in
             "sticky notifications" setting is on (GLC-30). A group's display type is fixed at
             registration time and not mutable at runtime, so the sticky variant must be its own
             group; post() picks between the two per event via notificationGroupFor(). -->
        <notificationGroup
            id="Cockpit for GitLab (Sticky)"
            displayType="STICKY_BALLOON"
            icon="/icons/toolwindow.svg"/>
        <diff.DiffExtension
            implementation="dev.jota.gitlabcockpit.ui.diff.CockpitDiffExtension"/>
        <postStartupActivity
            implementation="dev.jota.gitlabcockpit.core.BackgroundNotificationsPoller"/>
        <!-- Job logs open as editor tabs (GLC-43 A): the provider accepts only our JobLogVirtualFile and
             hides the default editor for it; the icon provider paints the tab glyph from the job status
             and the tab-title provider drops the .gitlab-log extension for a clean "<job> #<id>" title. -->
        <fileEditorProvider
            implementation="dev.jota.gitlabcockpit.ui.log.JobLogFileEditorProvider"/>
        <fileIconProvider
            implementation="dev.jota.gitlabcockpit.ui.log.JobLogIconProvider"/>
        <editorTabTitleProvider
            implementation="dev.jota.gitlabcockpit.ui.log.JobLogTabTitleProvider"/>
    </extensions>
</idea-plugin>
